#!/usr/bin/env bash
# dev-connect: SSH + tmux helper for the `devhost` PowerShell commands. Runs inside WSL.
#
# Every host NAME has up to two routes in ~/.ssh/config: NAME-lan and NAME-tail (Tailscale).
# "auto" tries LAN first (2 s timeout), then Tailscale.
#
#   dev-connect select  NAME [auto|lan|tail]   print the reachable route (and cache it for 2 min)
#   dev-connect check   NAME [auto|lan|tail]   probe each route and print timings
#   dev-connect attach  NAME SESSION           open/attach tmux SESSION on NAME (uses the cached route)
#   dev-connect routes  NAME                   list configured routes
#   dev-connect add-host NAME USER PORT LAN TAIL   write the managed ~/.ssh/config block (- = no address)
#   dev-connect has-tmux NAME                  exit 0 if tmux exists on the host
#   dev-connect pane ROUTE SESSION             (legacy positional syntax, still works)

set -u
readonly SSH_CONFIG="$HOME/.ssh/config"
readonly PROBE_TIMEOUT=24
readonly CACHE_SECONDS=120
readonly CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/dev-connect-$(id -u)"

die() { printf '%s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 64; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "Invalid host name: $1"; }

has_route() {   # is "Host ... ROUTE ..." declared in ~/.ssh/config?
  [[ -f "$SSH_CONFIG" ]] && grep -Eiq "^[[:space:]]*Host[[:space:]](.*[[:space:]])?$1([[:space:]]|\$)" "$SSH_CONFIG"
}

routes() {
  local name="$1" r
  for r in "$name-lan" "$name-tail"; do if has_route "$r"; then printf '%s\n' "$r"; fi; done
  return 0
}

probe() {
  local route="$1"; local -a extra=()
  [[ "$route" == *-lan ]] && extra=(-o ConnectionAttempts=1 -o ConnectTimeout=2)
  timeout "$PROBE_TIMEOUT" ssh -n "${extra[@]}" "$route" true </dev/null
}

candidates() {   # routes to try for a mode, in order
  local name="$1" mode="${2,,}"
  case "$mode" in
    lan)  has_route "$name-lan"  && echo "$name-lan" ;;
    tail) has_route "$name-tail" && echo "$name-tail" ;;
    auto|"") routes "$name" ;;
    *) die "Mode must be auto, lan or tail" ;;
  esac
}

select_route() {
  local name="$1" mode="${2:-auto}" r found=0
  valid_name "$name"
  while read -r r; do
    [[ -n "$r" ]] || continue
    found=1
    if probe "$r"; then
      mkdir -p "$CACHE_DIR" && chmod 700 "$CACHE_DIR"
      printf '%s\n' "$r" > "$CACHE_DIR/$name"
      printf '%s\n' "$r"; return 0
    fi
  done < <(candidates "$name" "$mode")
  (( found )) || die "No routes for '$name' in ~/.ssh/config. Run: devhost add"
  die "$name is unreachable ($mode). Run: devhost check $name"
}

check() {
  local name="$1" mode="${2:-auto}" r t0 t1 status=0
  valid_name "$name"
  while read -r r; do
    [[ -n "$r" ]] || continue
    t0=$(date +%s%3N)
    if probe "$r"; then t1=$(date +%s%3N); printf '%-16s OK      %5d ms\n' "$r" $((t1 - t0))
    else t1=$(date +%s%3N); printf '%-16s FAILED  %5d ms\n' "$r" $((t1 - t0)); status=1; fi
  done < <(candidates "$name" "$mode")
  return $status
}

cached_route() {
  local f="$CACHE_DIR/$1"
  [[ -f "$f" ]] && (( $(date +%s) - $(stat -c %Y "$f") < CACHE_SECONDS )) && cat "$f"
}

attach_session() {   # replace this process with ssh -> tmux
  local route="$1" session="$2"
  [[ "$session" =~ ^[A-Za-z0-9_.-]+$ ]] || die "Invalid tmux session name: $session"
  exec ssh -tt "$route" \
    "exec env LANG=en_US.UTF-8 LC_CTYPE=en_US.UTF-8 tmux -u new-session -A -s '$session'"
}

attach() {
  local name="$1" session="$2" route
  valid_name "$name"
  route="$(cached_route "$name")" || route=""
  [[ -n "$route" ]] || route="$(select_route "$name" auto)" || { read -rp 'Press Enter to close'; exit 1; }
  attach_session "$route" "$session"
}

add_host() {
  local name="$1" user="$2" port="$3" lan="$4" tail="$5"
  [[ "$lan" == "-" ]] && lan=""
  [[ "$tail" == "-" ]] && tail=""
  valid_name "$name"
  [[ -n "$lan$tail" ]] || die "Give a LAN or Tailscale address"
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  touch "$SSH_CONFIG" && chmod 600 "$SSH_CONFIG"
  local begin="# >>> dev-connect $name" end="# <<< dev-connect $name"
  if ! grep -qxF "$begin" "$SSH_CONFIG" && { has_route "$name-lan" || has_route "$name-tail"; }; then
    echo "~/.ssh/config already has hand-written entries for $name-lan/$name-tail. Keeping them."
    return 0
  fi
  # drop the old managed block, then append a fresh one
  awk -v b="$begin" -v e="$end" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$SSH_CONFIG" > "$SSH_CONFIG.tmp"
  {
    printf '%s\n# managed by `devhost add`; edits here get replaced\n' "$begin"
    local both=""
    if [[ -n "$lan" ]];  then printf 'Host %s-lan\n  HostName %s\n'  "$name" "$lan";  both+=" $name-lan"; fi
    if [[ -n "$tail" ]]; then printf 'Host %s-tail\n  HostName %s\n' "$name" "$tail"; both+=" $name-tail"; fi
    cat <<CFG
Host${both}
  User $user
  Port $port
  HostKeyAlias $name
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking accept-new
  ConnectTimeout 6
  ServerAliveInterval 15
  ServerAliveCountMax 4
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  LogLevel ERROR
CFG
    printf '%s\n' "$end"
  } >> "$SSH_CONFIG.tmp"
  mv "$SSH_CONFIG.tmp" "$SSH_CONFIG"
  echo "Wrote ~/.ssh/config entries for $name"
}

has_tmux() {
  local route; route="$(cached_route "$1")" || route=""
  [[ -n "$route" ]] || route="$(select_route "$1" auto)" || return 2
  ssh -n "$route" 'command -v tmux >/dev/null'
}

[[ $# -ge 1 ]] || usage
cmd="$1"; shift
case "$cmd" in
  select)   [[ $# -ge 1 ]] || usage; select_route "$1" "${2:-auto}" ;;
  check)    [[ $# -ge 1 ]] || usage; check "$1" "${2:-auto}" ;;
  attach)   [[ $# -eq 2 ]] || usage; attach "$1" "$2" ;;
  routes)   [[ $# -eq 1 ]] || usage; routes "$1" ;;
  add-host) [[ $# -eq 5 ]] || usage; add_host "$@" ;;
  has-tmux) [[ $# -eq 1 ]] || usage; has_tmux "$1" ;;
  pane)     [[ $# -eq 2 ]] || usage; attach_session "$1" "$2" ;;
  *) usage ;;
esac
