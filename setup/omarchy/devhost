#!/usr/bin/env bash
# devhost: SSH + tmux workspaces on Omarchy. Same idea as the Windows version: each host gets
# commands you choose (e.g. dev) that open one terminal per tmux session; Hyprland tiles them.
#   devhost add | list | check [name] | remove name | open name [-Check|-Target lan|tail]
set -uo pipefail
CFG="$HOME/.config/dev-hosts"; HOSTS="$CFG/hosts"; ALIASES="$CFG/aliases.sh"
mkdir -p "$CFG"; touch "$HOSTS"
DC="$HOME/.local/bin/dev-connect"

ask() { local p="$1" d="${2:-}" v; read -rp "$p${d:+ [$d]}: " v; echo "${v:-$d}"; }
term() { if command -v xdg-terminal-exec >/dev/null; then setsid -f xdg-terminal-exec "$@"; else setsid -f "${TERMINAL:-alacritty}" -e "$@"; fi; }
regen() {
  { echo "# generated by devhost"; while IFS='|' read -r n c s; do [ -n "$n" ] || continue
      for x in ${c//,/ }; do echo "$x() { devhost open $n \"\$@\"; }"; done; done < "$HOSTS"; } > "$ALIASES"
}

case "${1:-help}" in
  add)
    name=$(ask 'Short name (e.g. workstation)'); [[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "bad name"; exit 1; }
    if [ -n "$($DC routes "$name")" ] && [[ "$(ask 'SSH entries exist. Re-enter details? y/N' n)" != [yY]* ]]; then :; else
      user=$(ask 'SSH user' "$USER"); lan=$(ask 'LAN address (blank = none)'); tail=$(ask 'Tailscale address (blank = none)'); port=$(ask 'SSH port' 22)
      [ -n "$lan$tail" ] || { echo "need an address"; exit 1; }
      [ -f ~/.ssh/id_ed25519 ] || ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -C "$USER@$(hostname)"
      ssh-copy-id -i ~/.ssh/id_ed25519.pub -p "$port" -o HostKeyAlias="$name" -o StrictHostKeyChecking=accept-new "$user@${lan:-$tail}"
      $DC add-host "$name" "$user" "$port" "${lan:--}" "${tail:--}"
    fi
    $DC check "$name"
    $DC has-tmux "$name"; [ $? -eq 1 ] && [[ "$(ask 'tmux missing on host. Install with sudo? Y/n' y)" == [yY]* ]] && \
      ssh -tt -o BatchMode=no "$($DC select "$name")" 'sudo apt-get install -y tmux || sudo dnf install -y tmux || sudo pacman -S --noconfirm tmux'
    old=$(grep "^$name|" "$HOSTS" || true)
    cmds=$(ask 'Command(s) that open it, comma separated' "$(echo "$old" | cut -d'|' -f2 | grep . || echo dev)")
    sess=$(ask 'tmux sessions, one window each' "$(echo "$old" | cut -d'|' -f3 | grep . || echo main,code,logs,misc)")
    grep -v "^$name|" "$HOSTS" > "$HOSTS.tmp"; echo "$name|$cmds|$sess" >> "$HOSTS.tmp"; mv "$HOSTS.tmp" "$HOSTS"
    regen; echo "Done. Open a new terminal (or: . $ALIASES) and type ${cmds//,/ or }." ;;
  list) column -t -s'|' -N name,commands,sessions "$HOSTS" 2>/dev/null || cat "$HOSTS" ;;
  check) while IFS='|' read -r n _; do [ -z "${2:-}" ] || [ "$n" = "$2" ] || continue; echo "-- $n"; $DC check "$n"; done < "$HOSTS" ;;
  remove) grep -v "^${2:?name}|" "$HOSTS" > "$HOSTS.tmp"; mv "$HOSTS.tmp" "$HOSTS"; regen; echo "removed $2" ;;
  open)
    name="${2:?name}"; shift 2; mode=auto
    case "${1:-}" in -Check|--check) $DC check "$name"; exit;; -Target|--target) mode="${2,,}";; esac
    line=$(grep "^$name|" "$HOSTS") || { echo "unknown host $name"; exit 1; }
    route=$($DC select "$name" "$mode") || exit 1
    IFS=',' read -ra S <<< "$(echo "$line" | cut -d'|' -f3)"
    for s in "${S[@]}"; do term "$DC" pane "$route" "$s"; sleep 0.15; done ;;
  *) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
